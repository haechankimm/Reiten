여기에_Project_URL_입력
# 이 파일을 복사해서 .env로 만들고 실제 값을 채우세요.
#   cp .env.example .env
# .env는 .gitignore에 등록되어 있어 커밋되지 않습니다.

PORT=3000

# Supabase — supabase.com 프로젝트 생성 후 Project Settings > API 에서 확인
SUPABASE_URL=여기에_Project_URL_입력
SUPABASE_ANON_KEY=여기에_anon_key_입력
SUPABASE_SERVICE_ROLE_KEY=여기에_service_role_key_입력

# Resend — resend.com 가입 후 API Keys 메뉴에서 발급
# 도메인 인증 전에는 RESEND_FROM을 "onboarding@resend.dev"로 두면 테스트 발송 가능
RESEND_API_KEY=여기에_Resend_API_키_입력
RESEND_FROM=onboarding@resend.dev

# 주문 접수 시 알림 메일을 받을 주소 (사이트에 공개 노출되지 않는 내부용 주소)
ADMIN_NOTIFY_EMAIL=sovagsovag12570202@gmail.com

# Cloudinary — cloudinary.com 가입 후 Dashboard에서 확인
CLOUDINARY_CLOUD_NAME=여기에_클라우드_이름_입력
CLOUDINARY_API_KEY=여기에_API_키_입력
CLOUDINARY_API_SECRET=여기에_API_시크릿_입력
